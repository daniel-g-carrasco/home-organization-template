#!/usr/bin/env python3
"""Install concise folder guide files in the template data tree.

Default mode is dry-run. Use --apply to write files.
Existing unmanaged files are never overwritten.
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass
from pathlib import Path


MARKER = "<!-- managed-by: home-organization-template/install-folder-readmes -->"
FILE_NAME = "00-readme.md"


@dataclass(frozen=True)
