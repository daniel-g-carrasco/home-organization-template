def render(guide: FolderGuide) -> str:
    lines = [
        f"# {guide.title}",
        "",
        MARKER,
        "",
        "## Purpose",
        "",
        guide.purpose,
        "",
        "## Belongs Here",
        "",
    ]
    lines.extend(f"- {item}" for item in guide.belongs)
    lines.extend(["", "## Does Not Belong Here", ""])
    lines.extend(f"- {item}" for item in guide.not_belongs)
    lines.extend(["", "## How To Organize", ""])
    lines.extend(f"- {item}" for item in guide.organize)
    lines.extend(["", "## Search Tips", "", guide.search, ""])
    return "\n".join(lines)


def rel(path: Path, home: Path) -> str:
    try:
        return path.relative_to(home).as_posix()
    except ValueError:
        return path.as_posix()


def install(home: Path, apply: bool, update_managed: bool) -> int:
    created = 0
    updated = 0
    unchanged = 0
    skipped = 0

    for guide in GUIDES:
        folder = home / guide.path
        path = folder / FILE_NAME
        content = render(guide)

        if path.exists():
            existing = path.read_text(encoding="utf-8")
            if existing == content:
                unchanged += 1
                continue
            if MARKER in existing and update_managed:
                print(f"UPDATE {rel(path, home)}")
                updated += 1
                if apply:
                    path.write_text(content, encoding="utf-8")
                continue
            print(f"SKIP existing unmanaged or locally edited file: {rel(path, home)}")
            skipped += 1
            continue

        print(f"CREATE {rel(path, home)}")
        created += 1
        if apply:
            folder.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding="utf-8")

    mode = "applied" if apply else "dry-run"
    print(
        f"{mode}: {created} created, {updated} updated, "
        f"{unchanged} unchanged, {skipped} skipped"
    )
    if not apply:
        print("apply with: scripts/install-folder-readmes --apply")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--home", default=str(Path.home()))
    parser.add_argument("--apply", action="store_true")
    parser.add_argument(
        "--update-managed",
        action="store_true",
        help="update existing files only when they contain this script's management marker",
    )
    args = parser.parse_args()

    return install(Path(args.home).expanduser().resolve(), args.apply, args.update_managed)


if __name__ == "__main__":
    raise SystemExit(main())
