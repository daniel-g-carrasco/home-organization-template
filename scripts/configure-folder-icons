#!/usr/bin/env bash
set -euo pipefail

home="${HOME:?}"
apply=0
clear=0
theme=""

usage() {
  printf 'Usage: %s [--home PATH] [--theme NAME] [--apply] [--clear]\n' "$0"
}

while (($#)); do
  case "$1" in
    --home)
      home="${2:?missing value for --home}"
      shift 2
      ;;
    --theme)
      theme="${2:?missing value for --theme}"
      shift 2
      ;;
    --apply)
      apply=1
      shift
      ;;
    --clear)
      clear=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s\n' "$value"
}

current_icon_theme() {
  if [[ -n "$theme" ]]; then
    printf '%s\n' "$theme"
    return
  fi

  if command -v gsettings >/dev/null 2>&1; then
    gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'"
    return
  fi

  printf 'Adwaita\n'
}

theme_roots=(
  "$home/.local/share/icons"
  "$home/.icons"
  "/usr/local/share/icons"
  "/usr/share/icons"
)

preferred_folder_themes=(
  "Adwaita-yellow"
)

theme_dir() {
  local name="$1"
  local root

  for root in "${theme_roots[@]}"; do
    if [[ -d "$root/$name" ]]; then
      printf '%s\n' "$root/$name"
      return 0
    fi
  done

  return 1
}

theme_inherits() {
  local name="$1"
  local dir line inherited item

  dir="$(theme_dir "$name")" || return 0
  line="$(sed -n 's/^Inherits=//p' "$dir/index.theme" 2>/dev/null | head -n 1)"
  [[ -n "$line" ]] || return 0

  IFS=',' read -r -a inherited <<< "$line"
  for item in "${inherited[@]}"; do
    trim "$item"
  done
}

themes=()
theme_seen=":"

add_theme_tree() {
  local name inherited

  name="$(trim "$1")"
  [[ -n "$name" ]] || return 0
  [[ "$theme_seen" != *":$name:"* ]] || return 0

  themes+=("$name")
  theme_seen="${theme_seen}${name}:"

  while IFS= read -r inherited; do
    add_theme_tree "$inherited"
  done < <(theme_inherits "$name")
}

active_theme="$(current_icon_theme)"
add_theme_tree "Adwaita-yellow"
add_theme_tree "$active_theme"
add_theme_tree "MoreWaita"
add_theme_tree "Adwaita"
add_theme_tree "AdwaitaLegacy"
add_theme_tree "hicolor"

icon_dirs=(
  "scalable/places"
  "512x512/places"
  "256x256/places"
  "128x128/places"
  "96x96/places"
  "64x64/places"
  "48x48/places"
  "32x32/places"
  "24x24/places"
  "22x22/places"
  "16x16/places"
  "symbolic/places"
)

icon_exts=("svg")

resolve_icon() {
  local candidates_csv="$1"
  local candidate candidates theme_name root icon_dir ext path

  IFS=',' read -r -a candidates <<< "$candidates_csv"

  for candidate in "${candidates[@]}"; do
    candidate="$(trim "$candidate")"
    [[ -n "$candidate" ]] || continue

    for theme_name in "${preferred_folder_themes[@]}"; do
      for root in "${theme_roots[@]}"; do
        for icon_dir in "${icon_dirs[@]}"; do
          path="$root/$theme_name/$icon_dir/$candidate.svg"
          if [[ -e "$path" ]]; then
            printf '%s\n' "$path"
            return 0
          fi
        done
      done
    done
  done

  for theme_name in "${preferred_folder_themes[@]}"; do
    for root in "${theme_roots[@]}"; do
      for icon_dir in "${icon_dirs[@]}"; do
        path="$root/$theme_name/$icon_dir/folder.svg"
        if [[ -e "$path" ]]; then
          printf '%s\n' "$path"
          return 0
        fi
      done
    done
  done

  for candidate in "${candidates[@]}"; do
    candidate="$(trim "$candidate")"
    [[ -n "$candidate" ]] || continue

    for theme_name in "${themes[@]}"; do
      for root in "${theme_roots[@]}"; do
        for icon_dir in "${icon_dirs[@]}"; do
          for ext in "${icon_exts[@]}"; do
            path="$root/$theme_name/$icon_dir/$candidate.$ext"
            if [[ -e "$path" ]]; then
              printf '%s\n' "$path"
              return 0
            fi
          done
        done
      done
    done
  done

  return 1
}

icon_uri() {
  local path="$1"
  printf 'file://%s\n' "$path"
}

set_icon() {
  local target="$1"
  local icon_names="$2"
  local icon

  if [[ ! -e "$target" ]]; then
    printf 'SKIP missing target: %s\n' "$target"
    return
  fi

  if ! icon="$(resolve_icon "$icon_names")"; then
    printf 'SKIP missing theme icon for %s: %s\n' "$target" "$icon_names"
    return
  fi

  printf 'SET %s -> %s\n' "$target" "$icon"
  if ((apply)); then
    gio set -t string "$target" metadata::custom-icon "$(icon_uri "$icon")"
  fi
}

clear_icon() {
  local target="$1"

  if [[ ! -e "$target" ]]; then
    printf 'SKIP missing target: %s\n' "$target"
    return
  fi

  printf 'CLEAR %s\n' "$target"
  if ((apply)); then
    gio set -t unset "$target" metadata::custom-icon || true
  fi
}

icon_targets=(
  "data|folder-earth,folder-globe,folder-documents,folder|$home/data"
  "inbox|folder-download,folder|$home/data/inbox"
  "personal|folder-user,folder-private,folder-documents,folder|$home/data/personal"
  "work|folder-work,folder-documents,folder|$home/data/work"
  "community|folder-globe,folder-earth,folder-publicshare,folder|$home/data/community"
  "media|folder-camera,folder-pictures,folder|$home/data/media"
  "library|folder-books,folder-documents,folder|$home/data/library"
  "technology|folder-shell,folder-code,folder-git,folder|$home/data/technology"
  "projects|folder-projects,folder|$home/data/projects"
  "shared|folder-publicshare,folder|$home/data/shared"
  "archive|folder-backup,folder|$home/data/archive"
  "imports|folder-download,folder|$home/data/imports"
  "templates|folder-templates,folder|$home/data/templates"
  "development|folder-code,folder-git,folder|$home/dev"
  "scratch|folder-temp,folder|$home/scratch"

  "inbox-review|folder-drag-accept,folder-documents,folder|$home/data/inbox/00-review"
  "inbox-downloads|folder-download,folder|$home/scratch/downloads"
  "inbox-scans|folder-documents,folder|$home/data/inbox/20-scans"
  "inbox-mobile-imports|folder-android,folder-download,folder|$home/data/inbox/30-mobile-imports"
  "inbox-conflicts|folder-temp,folder|$home/data/inbox/99-migration-conflicts"

  "personal-admin|folder-documents,folder-private,folder|$home/data/personal/admin"
  "personal-finance|folder-money,folder-documents,folder|$home/data/personal/finance"
  "personal-health-fitness|folder-user,folder|$home/data/personal/health-fitness"
  "personal-people|folder-user,folder|$home/data/personal/people"
  "personal-places|folder-earth,folder-globe,folder|$home/data/personal/places"
  "personal-records|folder-private,folder-documents,folder|$home/data/personal/records"

  "work-admin|folder-documents,folder|$home/data/work/admin"
  "work-clients|folder-work,folder|$home/data/work/clients"
  "work-projects|folder-projects,folder|$home/data/work/projects"
  "work-reference|folder-books,folder-documents,folder|$home/data/work/reference"
  "work-archive|folder-backup,folder|$home/data/work/archive"

  "media-audio|folder-music,folder|$home/data/media/audio"
  "media-photos|folder-pictures,folder|$home/data/media/photos"
  "media-recordings|folder-music,folder|$home/data/media/recordings"
  "media-video|folder-videos,folder|$home/data/media/video"

  "library-books|folder-books,folder|$home/data/library/books"
  "library-fonts|folder-documents,folder|$home/data/library/fonts"
  "library-games|folder-games,folder|$home/data/library/games"
  "library-software|folder-appimage,folder-flatpak,folder|$home/data/library/software"

  "technology-admin|folder-documents,folder-private,folder|$home/data/technology/00-admin"
  "technology-devices|folder-android,folder|$home/data/technology/10-devices"
  "technology-network|folder-remote,folder-cloud,folder|$home/data/technology/20-network"
  "technology-servers|folder-shell,folder-code,folder|$home/data/technology/30-servers"
  "technology-services|folder-nextcloud,folder-syncthing,folder-remote,folder|$home/data/technology/40-services"
  "technology-reference|folder-books,folder-documents,folder|$home/data/technology/50-reference"
  "technology-archive|folder-backup,folder|$home/data/technology/90-archive"

  "shared-outgoing|folder-publicshare,folder|$home/data/shared/10-outgoing"
  "shared-published|folder-globe,folder-publicshare,folder|$home/data/shared/20-published"
  "shared-archive|folder-backup,folder|$home/data/shared/90-archive"

  "archive-education|folder-school,folder-books,folder|$home/data/archive/education"
  "archive-family|folder-user,folder|$home/data/archive/family"
  "archive-personal|folder-private,folder-user,folder|$home/data/archive/personal"
  "archive-work|folder-work,folder|$home/data/archive/work"
)

printf 'Icon theme order: %s\n' "${themes[*]}"

for entry in "${icon_targets[@]}"; do
  IFS='|' read -r _label icon_names target <<< "$entry"

  if ((clear)); then
    clear_icon "$target"
  else
    set_icon "$target" "$icon_names"
  fi
done

if ((apply)); then
  nautilus -q >/dev/null 2>&1 || true
  printf 'Folder icon metadata updated. Reopen Nautilus to refresh.\n'
else
  printf 'dry-run only: no files were changed\n'
  printf 'apply with: %s --apply\n' "$0"
fi
