#!/usr/bin/env bash
set -euo pipefail

home="${HOME:?}"
apply=0
clear=0
icons_dir=""

usage() {
  printf 'Usage: %s [--home PATH] [--icons-dir PATH] [--apply] [--clear]\n' "$0"
}

while (($#)); do
  case "$1" in
    --home)
      home="${2:?missing value for --home}"
      shift 2
      ;;
    --icons-dir)
      icons_dir="${2:?missing value for --icons-dir}"
      shift 2
      ;;
    --apply)
      apply=1
      shift
      ;;
    --clear)
      clear=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

icons_dir="${icons_dir:-$home/.local/share/icons/home-organization}"

icon_targets=(
  "data|data|#5c7cfa|database|$home/data"
  "inbox|inbox|#3f8f68|inbox|$home/data/inbox"
  "personal|personal|#3b82f6|user|$home/data/personal"
  "work|work|#7c5cdb|briefcase|$home/data/work"
  "community|community|#10a37f|community|$home/data/community"
  "media|media|#e25555|play|$home/data/media"
  "library|library|#b7791f|book|$home/data/library"
  "technology|technology|#2f7d8c|chip|$home/data/technology"
  "projects|projects|#7c3aed|project|$home/data/projects"
  "shared|shared|#0f766e|share|$home/data/shared"
  "archive|archive|#6b7280|archive|$home/data/archive"
  "imports|imports|#2563eb|import|$home/data/imports"
  "templates|templates|#d97706|template|$home/data/templates"
  "development|development|#2563eb|code|$home/dev"
  "scratch|scratch|#ef7d00|scratch|$home/scratch"
)

symbol_svg() {
  case "$1" in
    database)
      cat <<'EOF'
<ellipse cx="86" cy="63" rx="13" ry="5"/>
<path d="M73 63v18c0 3 6 6 13 6s13-3 13-6V63"/>
<path d="M73 72c0 3 6 6 13 6s13-3 13-6"/>
EOF
      ;;
    inbox)
      cat <<'EOF'
<path d="M86 58v22"/>
<path d="M75 70l11 11 11-11"/>
<path d="M70 88h32"/>
EOF
      ;;
    user)
      cat <<'EOF'
<circle cx="86" cy="65" r="8"/>
<path d="M70 91c3-11 29-11 32 0"/>
EOF
      ;;
    briefcase)
      cat <<'EOF'
<rect x="68" y="67" width="36" height="24" rx="4"/>
<path d="M79 67v-6h14v6"/>
<path d="M68 76h36"/>
EOF
      ;;
    community)
      cat <<'EOF'
<circle cx="78" cy="68" r="6"/>
<circle cx="95" cy="68" r="6"/>
<path d="M66 90c3-10 21-10 24 0"/>
<path d="M84 90c3-10 21-10 24 0"/>
EOF
      ;;
    play)
      cat <<'EOF'
<path d="M78 61l24 15-24 15z"/>
EOF
      ;;
    book)
      cat <<'EOF'
<path d="M70 60h21a8 8 0 0 1 8 8v23H77a7 7 0 0 0-7 7z"/>
<path d="M70 60v38"/>
<path d="M78 70h14"/>
EOF
      ;;
    chip)
      cat <<'EOF'
<rect x="74" y="64" width="25" height="25" rx="4"/>
<path d="M69 70h5M69 78h5M69 86h5M99 70h5M99 78h5M99 86h5M78 59v5M86 59v5M94 59v5M78 89v5M86 89v5M94 89v5"/>
EOF
      ;;
    project)
      cat <<'EOF'
<path d="M72 88V61h23l-5 8 5 8H72"/>
<path d="M72 92h26"/>
EOF
      ;;
    share)
      cat <<'EOF'
<circle cx="74" cy="75" r="6"/>
<circle cx="98" cy="63" r="6"/>
<circle cx="98" cy="88" r="6"/>
<path d="M80 72l12-6M80 78l12 7"/>
EOF
      ;;
    archive)
      cat <<'EOF'
<rect x="68" y="66" width="36" height="25" rx="4"/>
<path d="M72 60h28l4 6H68z"/>
<path d="M80 76h12"/>
EOF
      ;;
    import)
      cat <<'EOF'
<path d="M86 58v24"/>
<path d="M76 72l10 10 10-10"/>
<rect x="70" y="86" width="32" height="8" rx="2"/>
EOF
      ;;
    template)
      cat <<'EOF'
<path d="M75 58h18l9 9v27H75z"/>
<path d="M93 58v9h9"/>
<path d="M81 75h15M81 83h15"/>
EOF
      ;;
    code)
      cat <<'EOF'
<path d="M78 65L66 77l12 12"/>
<path d="M94 65l12 12-12 12"/>
<path d="M90 61l-8 32"/>
EOF
      ;;
    scratch)
      cat <<'EOF'
<path d="M72 87l18-26 12 8-18 26-14 3z"/>
<path d="M90 61l5-7 12 8-5 7"/>
<path d="M70 98l7-10"/>
EOF
      ;;
  esac
}

write_icon() {
  local name="$1"
  local color="$2"
  local symbol="$3"
  local path="$icons_dir/$name.svg"

  mkdir -p "$icons_dir"
  {
    cat <<EOF
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128">
  <path fill="#c98f24" d="M10 32c0-6 5-11 11-11h30c4 0 7 2 9 5l6 8h41c6 0 11 5 11 11v10H10z"/>
  <rect x="10" y="39" width="108" height="72" rx="12" fill="#f5c85b"/>
  <path fill="#ffe08a" d="M10 51h108v48c0 7-5 12-12 12H22c-7 0-12-5-12-12z"/>
  <circle cx="86" cy="77" r="31" fill="$color"/>
  <g fill="none" stroke="#ffffff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
EOF
    symbol_svg "$symbol"
    cat <<'EOF'
  </g>
</svg>
EOF
  } > "$path"
}

icon_uri() {
  local path="$1"
  printf 'file://%s\n' "$path"
}

set_icon() {
  local target="$1"
  local icon="$2"
  if [[ ! -e "$target" ]]; then
    printf 'SKIP missing target: %s\n' "$target"
    return
  fi
  printf 'SET %s -> %s\n' "$target" "$icon"
  if ((apply)); then
    gio set -t string "$target" metadata::custom-icon "$(icon_uri "$icon")"
  fi
}

clear_icon() {
  local target="$1"
  if [[ ! -e "$target" ]]; then
    printf 'SKIP missing target: %s\n' "$target"
    return
  fi
  printf 'CLEAR %s\n' "$target"
  if ((apply)); then
    gio set -t unset "$target" metadata::custom-icon || true
  fi
}

for entry in "${icon_targets[@]}"; do
  IFS='|' read -r name _label color symbol target <<< "$entry"
  icon="$icons_dir/$name.svg"
  if ((clear)); then
    clear_icon "$target"
  else
    printf 'ICON %s\n' "$icon"
    if ((apply)); then
      write_icon "$name" "$color" "$symbol"
    fi
    set_icon "$target" "$icon"
  fi
done

if ((apply)); then
  nautilus -q >/dev/null 2>&1 || true
  printf 'Folder icon metadata updated. Reopen Nautilus to refresh the sidebar.\n'
else
  printf 'dry-run only: no files were changed\n'
  printf 'apply with: %s --apply\n' "$0"
fi
